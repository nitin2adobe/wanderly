{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aaa:contracts:v1:canonical-signal",
  "title": "CanonicalSignal v1",
  "description": "One raw, site-agnostic observation produced by the AAA collector from aaa.track(), data-aaa-* attributes or ACDL via the Site Profile signalMap. Raw only: derived states (hesitation, inProgress) never appear here. Untrusted input: it is an observation, never an instruction or policy. Carries no free text, form contents, raw query strings or account identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "signalId", "kind", "sessionId", "seq", "ts",
    "profileId", "profileVersion", "pageInstanceId", "pageRevision", "pageType",
    "locale", "entityIds", "provenance", "attributes"
  ],
  "properties": {
    "schemaVersion": { "$ref": "urn:aaa:contracts:v1:common#/$defs/schemaVersion" },
    "signalId": { "$ref": "urn:aaa:contracts:v1:common#/$defs/id" },
    "kind": { "$ref": "urn:aaa:contracts:v1:common#/$defs/rawSignalKind" },
    "sessionId": { "$ref": "urn:aaa:contracts:v1:common#/$defs/id" },
    "seq": { "$ref": "urn:aaa:contracts:v1:common#/$defs/sequence" },
    "ts": { "$ref": "urn:aaa:contracts:v1:common#/$defs/timestamp" },
    "profileId": { "$ref": "urn:aaa:contracts:v1:common#/$defs/id" },
    "profileVersion": { "$ref": "urn:aaa:contracts:v1:common#/$defs/version" },
    "pageInstanceId": { "$ref": "urn:aaa:contracts:v1:common#/$defs/id" },
    "pageRevision": { "$ref": "urn:aaa:contracts:v1:common#/$defs/pageRevision" },
    "pageType": {
      "description": "Profile taxonomy page type ID.",
      "$ref": "urn:aaa:contracts:v1:common#/$defs/id"
    },
    "locale": { "$ref": "urn:aaa:contracts:v1:common#/$defs/locale" },
    "entityIds": {
      "description": "Profile-scoped entity IDs this signal concerns. Empty when none apply.",
      "$ref": "urn:aaa:contracts:v1:common#/$defs/idList"
    },
    "provenance": { "$ref": "urn:aaa:contracts:v1:common#/$defs/provenance" },
    "source": {
      "description": "Collector input path that produced the signal; diagnostic only.",
      "type": "string",
      "enum": ["track", "data-attribute", "acdl"]
    },
    "attributes": {
      "description": "Kind-specific payload. Only the fields allowed for the signal kind are accepted.",
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "page.viewed" } } },
      "then": {
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "navigationType": { "type": "string", "enum": ["navigate", "reload", "back_forward", "spa"] }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "entity.viewed" } } },
      "then": {
        "properties": {
          "entityIds": { "minItems": 1 },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entityType"],
            "properties": { "entityType": { "$ref": "urn:aaa:contracts:v1:common#/$defs/id" } }
          }
        }
      }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "entity.compared" } } },
      "then": {
        "properties": {
          "entityIds": { "minItems": 2 },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entityType"],
            "properties": { "entityType": { "$ref": "urn:aaa:contracts:v1:common#/$defs/id" } }
          }
        }
      }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "info.sought" } } },
      "then": {
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topicId"],
            "properties": { "topicId": { "$ref": "urn:aaa:contracts:v1:common#/$defs/id" } }
          }
        }
      }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "facet.selected" } } },
      "then": {
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["facetId", "valueIds"],
            "properties": {
              "facetId": { "$ref": "urn:aaa:contracts:v1:common#/$defs/id" },
              "valueIds": {
                "description": "Profile-declared facet value IDs, never free text.",
                "$ref": "urn:aaa:contracts:v1:common#/$defs/idList",
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "transaction.step" } } },
      "then": {
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase"],
            "properties": {
              "phase": { "$ref": "urn:aaa:contracts:v1:common#/$defs/transactionPhase" },
              "flowId": { "$ref": "urn:aaa:contracts:v1:common#/$defs/id" },
              "stepId": { "$ref": "urn:aaa:contracts:v1:common#/$defs/id" }
            }
          }
        }
      }
    }
  ]
}
