# Copy to .env.local; never commit real credentials.
WANDERLY_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=approved-model
# OPENAI_BASE_URL=https://api.openai.com/v1

# Bedrock Converse alternative:
# WANDERLY_LLM_PROVIDER=bedrock
# WANDERLY_LLM_ENDPOINT=https://bedrock-runtime.us-east-2.amazonaws.com/model/approved-model/converse
# WANDERLY_LLM_MODEL=approved-model
# AWS_BEARER_TOKEN_BEDROCK=
# WANDERLY_LLM_API_KEY can also supply the Bedrock bearer token.

# Generic HTTP provider:
# WANDERLY_LLM_PROVIDER=http
# WANDERLY_LLM_ENDPOINT=
# WANDERLY_LLM_API_KEY=
# WANDERLY_LLM_MODEL=

# Safe default: documented welcome suggestion, submitted only by the visitor.
# Set true only for the existing experimental, undocumented auto-submit hook.
# NEXT_PUBLIC_ variables are public and build-time; rebuild after changes.
NEXT_PUBLIC_BC_LEGACY_AUTO_SUBMIT=false
