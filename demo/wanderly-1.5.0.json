      {
        "playbookId": "destination-compare",
        "locale": "en-US",
        "intent": "Help compare the visitor's selected destinations",
        "tone": "Clear and neutral",
        "allowedClaims": [
          {
            "text": "Changing bases means road transfers. Keep fewer stops if your priority is uninterrupted beach time.",
            "evidenceIds": [
              "ev-destination-bali"
            ]
          },
          {
            "text": "Less variety beyond the resort. Meal plans, island transfers and villa types can change the total substantially.",
            "evidenceIds": [
              "ev-destination-maldives"
            ]
          },
          {
            "text": "More walking and luggage changes than an island trip. Popular seasonal dates need extra planning.",
            "evidenceIds": [
              "ev-destination-japan"
            ]
          },
          {
            "text": "Mountain outings depend on conditions. Add a flexible day rather than making every connection tight.",
            "evidenceIds": [
              "ev-destination-switzerland"
            ]
          },
          {
            "text": "Combining city and island or northern stays adds a domestic connection; choose one region if you want less packing.",
            "evidenceIds": [
              "ev-destination-thailand"
            ]
          },
          {
            "text": "Historic streets can be hilly and uneven. A central hotel and slower walking route may matter more than fitting in every sight.",
            "evidenceIds": [
              "ev-destination-portugal"
            ]
          }
        ],
        "aspects": [
          {
            "id": "transfers",
            "label": "transfers",
            "evidenceIds": [
              "ev-destination-bali",
              "ev-destination-maldives"
            ]
          },
          {
            "id": "total-cost",
            "label": "total cost",
            "evidenceIds": [
              "ev-destination-maldives"
            ]
          }
        ],
        "avoidTerms": [
          "guaranteed"
        ],
